# Copy to .env (optional): docker compose reads it automatically.
# Every variable has a working default for local development.

# --- PostgreSQL ---
POSTGRES_DB=blog_manager
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=change_me

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE=5242880
PUBLIC_API_URL=http://localhost:8005
CORS_ORIGINS=http://localhost:3005
COOKIE_SECURE=false

# --- Frontend (inlined at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8005/api/v1

# --- Host ports ---
FRONTEND_PORT=3005
BACKEND_PORT=8005
DB_PORT=5452
